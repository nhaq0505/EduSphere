digraph EduSphere {
graph [rankdir=LR, nodesep=0.48, ranksep=1.15, splines=spline, outputorder=edgesfirst, bgcolor="#ffffff", pad=0.35, fontname="Arial", fontsize=22, labelloc=t, label="EduSphere - DATABASE DIAGRAM | 44 TABLES | 88 FOREIGN KEYS\nPK = primary key   FK = foreign key   NULL: Y = allowed, - = not allowed\nSource: SQLQuery1.sql | Diagram of the target schema; no database changes"];
