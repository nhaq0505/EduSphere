<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý tài khoản — EduSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css?v=restore-0bfd0e1-20261014"></head><body>
<jsp:include page="/WEB-INF/views/common/navbar.jsp"/>
<main class="shell">
<header class="page-heading"><div><p class="eyebrow">Không gian quản trị</p><h1>Quản lý tài khoản</h1><p>Gán vai trò, khóa và khôi phục tài khoản. Mọi thay đổi đều được ghi lịch sử.</p></div></header>
<c:if test="${not empty success}"><div class="alert alert--success"><c:out value="${success}"/></div></c:if>
<c:if test="${not empty error}"><div class="alert alert--error"><c:out value="${error}"/></div></c:if>
<form class="card account-search" method="get" action="${pageContext.request.contextPath}/admin/users"><div class="field"><label for="account-q">Tìm theo tên hoặc email</label><input id="account-q" name="q" value="<c:out value='${q}'/>" maxlength="255" placeholder="Nhập tên hoặc email"></div><button class="button button--primary" type="submit">Tìm tài khoản</button></form>
<c:choose><c:when test="${empty usersPage.content}"><div class="empty-state"><span class="empty-state__mark">⌕</span><h2>Không tìm thấy tài khoản</h2><p>Thử một tên hoặc email khác.</p></div></c:when><c:otherwise>
<div class="account-list"><c:forEach var="user" items="${usersPage.content}"><article class="card account-card">
<div class="account-card__identity"><div><h2><c:out value="${user.fullName}"/></h2><p><c:out value="${user.email}"/></p></div><div><c:choose><c:when test="${user.status eq 'ACTIVE'}"><span class="pill pill--success">Đang hoạt động</span></c:when><c:when test="${user.status eq 'LOCKED'}"><span class="pill pill--danger">Đã khóa</span></c:when><c:otherwise><span class="pill pill--gold">Chờ xác minh</span></c:otherwise></c:choose><c:if test="${user.self}"> <span class="pill pill--neutral">Tài khoản của bạn</span></c:if></div></div>
<div class="account-card__actions"><form method="post" action="${pageContext.request.contextPath}/admin/users/${user.userId}/roles"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><fieldset <c:if test="${user.self}">disabled</c:if>><legend>Vai trò</legend><div class="role-choices"><label><input type="checkbox" name="roles" value="STUDENT" <c:if test="${user.student}">checked</c:if>> Học viên</label><label><input type="checkbox" name="roles" value="INSTRUCTOR" <c:if test="${user.instructor}">checked</c:if>> Giảng viên</label><label><input type="checkbox" name="roles" value="ADMINISTRATOR" <c:if test="${user.administrator}">checked</c:if>> Quản trị viên</label></div><button class="button button--outline button--small" type="submit">Lưu vai trò</button></fieldset></form>
<div class="account-card__status"><c:if test="${not user.self and user.status eq 'ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/admin/users/${user.userId}/status"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="action" value="LOCK"><div class="field"><label for="reason-${user.userId}">Lý do khóa *</label><textarea id="reason-${user.userId}" name="reason" maxlength="1000" rows="2" required></textarea></div><button class="button button--danger button--small" type="submit">Khóa tài khoản</button></form></c:if>
<c:if test="${not user.self and user.status eq 'LOCKED'}"><form method="post" action="${pageContext.request.contextPath}/admin/users/${user.userId}/status"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="action" value="RESTORE"><button class="button button--primary button--small" type="submit">Khôi phục tài khoản</button></form></c:if>
<c:if test="${user.self}"><p class="small muted">Bạn không thể sửa vai trò hoặc trạng thái của chính mình.</p></c:if><c:if test="${user.status eq 'PENDING'}"><p class="small muted">Tài khoản đang chờ xác minh email.</p></c:if></div></div></article></c:forEach></div>
<c:if test="${usersPage.totalPages gt 1}"><nav class="pagination" aria-label="Phân trang tài khoản"><c:if test="${usersPage.number gt 0}"><c:url var="prev" value="/admin/users"><c:param name="q" value="${q}"/><c:param name="page" value="${usersPage.number - 1}"/></c:url><a href="${prev}">← Trang trước</a></c:if><span>Trang ${usersPage.number + 1} / ${usersPage.totalPages}</span><c:if test="${usersPage.number + 1 lt usersPage.totalPages}"><c:url var="next" value="/admin/users"><c:param name="q" value="${q}"/><c:param name="page" value="${usersPage.number + 1}"/></c:url><a href="${next}">Trang sau →</a></c:if></nav></c:if>
</c:otherwise></c:choose></main><jsp:include page="/WEB-INF/views/common/footer.jsp"/></body></html>
