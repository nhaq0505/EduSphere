<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Chi tiết bài học — EduSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body>
<jsp:include page="/WEB-INF/views/common/navbar.jsp"/>
<main class="shell shell--narrow"><a class="back-link" href="${pageContext.request.contextPath}/instructor/courses/${course.courseId}/lessons">← Danh sách bài học</a>
<header class="page-heading"><div><p class="eyebrow">Bài học ${lesson.orderIndex} · <c:out value="${course.title}"/></p><h1><c:out value="${lesson.title}"/></h1><c:choose><c:when test="${lesson.status eq 'PUBLISHED'}"><span class="pill pill--success">Học viên có thể xem</span></c:when><c:otherwise><span class="pill pill--neutral">Bản nháp</span></c:otherwise></c:choose></div><c:if test="${editable}"><a class="button button--outline" href="${pageContext.request.contextPath}/instructor/courses/${course.courseId}/lessons/${lesson.lessonId}/edit">Chỉnh sửa bài học</a></c:if></header>
<c:if test="${not empty success}"><div class="alert alert--success"><c:out value="${success}"/></div></c:if>
<div class="card form-card"><h2>Nội dung</h2><p class="lesson-body"><c:out value="${lesson.content}" default="Chưa có nội dung."/></p></div>
<section class="section-heading"><h2>Tài liệu học tập</h2></section>
<c:choose><c:when test="${empty materials}"><div class="empty-state"><h3>Chưa có tài liệu</h3><p>Bạn có thể gắn đường dẫn tài liệu, liên kết hoặc video cho bài học.</p></div></c:when><c:otherwise><div class="material-list"><c:forEach var="material" items="${materials}"><article class="card material-item"><span class="pill pill--neutral"><c:choose><c:when test="${material.type eq 'VIDEO'}">Video</c:when><c:when test="${material.type eq 'DOCUMENT'}">Tài liệu</c:when><c:otherwise>Liên kết</c:otherwise></c:choose></span><strong><c:out value="${material.title}"/></strong><c:if test="${fn:startsWith(material.fileUrl, 'https://') or fn:startsWith(material.fileUrl, 'http://')}"><a href="<c:out value='${material.fileUrl}'/>" target="_blank" rel="noopener noreferrer">Mở tài liệu ↗</a></c:if></article></c:forEach></div></c:otherwise></c:choose>
<c:if test="${editable}"><section class="section-heading"><h2>Thêm tài liệu</h2></section><div class="card form-card"><form:form method="post" modelAttribute="materialForm" action="${pageContext.request.contextPath}/instructor/courses/${course.courseId}/lessons/${lesson.lessonId}/materials" htmlEscape="true"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
<div class="field"><label for="material-title">Tên tài liệu *</label><form:input path="title" id="material-title" maxlength="255" required="required"/><form:errors path="title" cssClass="field-error"/></div>
<div class="field"><label for="material-type">Loại *</label><form:select path="type" id="material-type"><form:option value="" label="Chọn loại"/><form:option value="DOCUMENT" label="Tài liệu"/><form:option value="LINK" label="Liên kết"/><form:option value="VIDEO" label="Video"/></form:select><form:errors path="type" cssClass="field-error"/></div>
<div class="field"><label for="material-url">Đường dẫn URL *</label><form:input path="fileUrl" id="material-url" type="url" maxlength="2048" required="required" placeholder="https://..."/><span class="field__hint">Dùng đường dẫn http hoặc https tới tài liệu hay video đã được lưu trữ.</span><form:errors path="fileUrl" cssClass="field-error"/></div>
<button class="button button--primary" type="submit">Thêm tài liệu</button></form:form></div></c:if>
</main><jsp:include page="/WEB-INF/views/common/footer.jsp"/></body></html>
