<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Học bài — EduSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body>
<jsp:include page="/WEB-INF/views/common/navbar.jsp"/>
<main class="shell"><a class="back-link" href="${pageContext.request.contextPath}/my-courses">← Khóa học của tôi</a>
<header class="page-heading"><div><p class="eyebrow">Không gian học viên</p><h1><c:out value="${study.courseTitle}"/></h1><p>Giảng viên <c:out value="${study.instructorName}"/></p></div></header>
<c:if test="${not empty success}"><div class="alert alert--success"><c:out value="${success}"/></div></c:if>
<c:choose><c:when test="${empty study.currentLesson}"><div class="empty-state"><span class="empty-state__mark">○</span><h2>Chưa có bài học để xem</h2><p>Giảng viên chưa công bố bài học trong khóa này. Bạn có thể quay lại sau.</p><a class="button button--outline" href="${pageContext.request.contextPath}/my-courses">Khóa học của tôi</a></div></c:when><c:otherwise>
<div class="study-layout"><aside class="card study-sidebar"><h2>Nội dung khóa học</h2><p class="small muted">${study.completedCount} / ${study.totalCount} bài đã hoàn thành</p><progress value="${study.completedCount}" max="${study.totalCount}"></progress><ol class="study-outline"><c:forEach var="item" items="${study.lessons}"><li><a class="<c:if test='${item.current}'>study-outline__active</c:if>" href="${pageContext.request.contextPath}/courses/${study.courseId}/lessons/${item.lessonId}"><span><c:out value="${item.orderIndex}"/>.</span> <c:out value="${item.title}"/><c:if test="${item.completed}"><span class="pill pill--success">Đã học</span></c:if></a></li></c:forEach></ol></aside>
<article class="card study-content"><p class="eyebrow">Bài ${study.currentLesson.orderIndex}</p><h2><c:out value="${study.currentLesson.title}"/></h2><p class="lesson-body"><c:out value="${study.lessonContent}" default="Bài học này chưa có nội dung chữ."/></p>
<h3>Tài liệu của bài học</h3><c:choose><c:when test="${empty study.materials}"><p class="muted">Chưa có tài liệu đính kèm.</p></c:when><c:otherwise><div class="material-list"><c:forEach var="material" items="${study.materials}"><article class="material-item"><span class="pill pill--neutral"><c:choose><c:when test="${material.type eq 'VIDEO'}">Video</c:when><c:when test="${material.type eq 'DOCUMENT'}">Tài liệu</c:when><c:otherwise>Liên kết</c:otherwise></c:choose></span><strong><c:out value="${material.title}"/></strong><c:if test="${not empty material.fileUrl}"><a href="<c:out value='${material.fileUrl}'/>" target="_blank" rel="noopener noreferrer">Mở ↗</a></c:if></article></c:forEach></div></c:otherwise></c:choose>
<div class="study-actions"><c:if test="${not empty study.prevLessonId}"><a class="button button--outline" href="${pageContext.request.contextPath}/courses/${study.courseId}/lessons/${study.prevLessonId}">← Bài trước</a></c:if><c:if test="${not study.currentLesson.completed}"><form method="post" action="${pageContext.request.contextPath}/courses/${study.courseId}/lessons/${study.currentLesson.lessonId}/complete"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="button button--primary" type="submit">Đánh dấu đã học</button></form></c:if><c:if test="${not empty study.nextLessonId}"><a class="button button--outline" href="${pageContext.request.contextPath}/courses/${study.courseId}/lessons/${study.nextLessonId}">Bài tiếp →</a></c:if></div>
</article></div></c:otherwise></c:choose>
</main><jsp:include page="/WEB-INF/views/common/footer.jsp"/></body></html>
